<%= form_with model: content, class: "space-y-5" do |f| %>
  <%= render "shared/error_messages", object: content %>

  <div>
    <%= f.label :title, "タイトル", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :title,
        class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :url, "URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.url_field :url, placeholder: "https://",
        class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :media_type, "種別", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :media_type,
        [["本", "book"], ["YouTube", "youtube"], ["動画配信", "video"], ["記事", "article"], ["その他", "other"]],
        { include_blank: "-- 選択してください --" },
        class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :status, "ステータス", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :status,
        [["未消化", "unread"], ["消化済み", "done"]],
        {},
        class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500",
        id: "content_status" %>
  </div>

  <div id="rating_field" class="<%= content.unread? ? 'hidden' : '' %>">
    <%= f.label :rating, "星評価（消化済み時のみ）", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :rating,
        [["-", ""], ["★", 1], ["★★", 2], ["★★★", 3], ["★★★★", 4], ["★★★★★", 5]],
        {},
        class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :memo, "メモ・感想", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :memo, rows: 4,
        class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <%= f.submit content.new_record? ? "登録する" : "更新する",
      class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2 rounded cursor-pointer" %>
<% end %>

<script>
  document.getElementById("content_status").addEventListener("change", function() {
    const ratingField = document.getElementById("rating_field");
    ratingField.classList.toggle("hidden", this.value !== "done");
    if (this.value !== "done") {
      ratingField.querySelector("select").value = "";
    }
  });
</script>
