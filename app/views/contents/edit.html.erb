<div class="max-w-xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">コンテンツを編集</h1>
    <%= link_to "← 詳細に戻る", content_path(@content), class: "text-sm text-indigo-600 hover:underline" %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <%= render "form", content: @content %>
  </div>
</div>
