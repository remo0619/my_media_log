<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-800">コンテンツ一覧</h1>
  <%= link_to "+ 新規登録", new_content_path,
      class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded text-sm" %>
</div>

<%# フィルタ・検索フォーム %>
<%= form_with url: contents_path, method: :get, local: true, class: "bg-white rounded-lg shadow-sm border border-gray-100 px-5 py-4 mb-5" do |f| %>
  <div class="flex flex-wrap gap-3 items-end">
    <div class="w-full sm:w-auto">
      <%= f.label :media_type, "種別", class: "block text-xs text-gray-500 mb-1" %>
      <%= f.select :media_type,
          [["すべて", ""], ["本", "book"], ["YouTube", "youtube"], ["動画配信", "video"], ["記事", "article"], ["その他", "other"]],
          { selected: params[:media_type] },
          class: "w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div class="w-full sm:w-auto">
      <%= f.label :status, "ステータス", class: "block text-xs text-gray-500 mb-1" %>
      <%= f.select :status,
          [["すべて", ""], ["未消化", "unread"], ["消化済み", "done"]],
          { selected: params[:status] },
          class: "w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div class="w-full sm:flex-1">
      <%= f.label :q, "キーワード", class: "block text-xs text-gray-500 mb-1" %>
      <%= f.text_field :q, value: params[:q], placeholder: "タイトルで検索",
          class: "w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div class="flex gap-2 w-full sm:w-auto">
      <%= f.submit "検索", class: "flex-1 sm:flex-none bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-1.5 rounded cursor-pointer" %>
      <%= link_to "リセット", contents_path, class: "flex-1 sm:flex-none text-center text-sm text-gray-500 hover:text-gray-700 px-3 py-1.5 rounded border border-gray-300 hover:bg-gray-50" %>
    </div>
  </div>
<% end %>

<% if @contents.empty? %>
  <div class="text-center py-20 text-gray-400">
    <% if params[:media_type].present? || params[:status].present? || params[:q].present? %>
      <p class="text-lg">該当するコンテンツが見つかりません</p>
      <p class="text-sm mt-1"><%= link_to "絞り込みをリセット", contents_path, class: "text-indigo-500 hover:underline" %></p>
    <% else %>
      <p class="text-lg">まだコンテンツがありません</p>
      <p class="text-sm mt-1">「+ 新規登録」からコンテンツを追加してみましょう</p>
    <% end %>
  </div>
<% else %>
  <div class="grid gap-3">
    <% @contents.each do |content| %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-100 px-5 py-4 flex items-center justify-between hover:shadow transition">
        <div class="flex items-center gap-4 min-w-0">
          <span class="shrink-0 text-xs font-medium px-2 py-0.5 rounded <%= media_type_badge_class(content.media_type) %>">
            <%= t_media_type(content.media_type) %>
          </span>
          <div class="min-w-0">
            <%= link_to content.title, content_path(content),
                class: "font-medium text-gray-800 hover:text-indigo-600 truncate block" %>
            <% if content.url.present? %>
              <p class="text-xs text-gray-400 truncate"><%= content.url %></p>
            <% end %>
          </div>
        </div>
        <div class="flex items-center gap-3 shrink-0 ml-4">
          <% if content.rating.present? %>
            <span class="text-yellow-500 text-sm"><%= "★" * content.rating %></span>
          <% end %>
          <span class="<%= content.done? ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %> text-xs font-semibold px-2 py-0.5 rounded-full">
            <%= content.done? ? "消化済み" : "未消化" %>
          </span>
          <%= button_to content.unread? ? "消化済みにする" : "未消化に戻す",
              toggle_status_content_path(content), method: :patch,
              class: "text-xs px-3 py-1 rounded border cursor-pointer #{ content.unread? ? 'border-green-400 text-green-600 hover:bg-green-50' : 'border-gray-300 text-gray-500 hover:bg-gray-50' }" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
