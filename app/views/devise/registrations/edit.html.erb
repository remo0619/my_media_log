<div class="max-w-xl mx-auto">
  <h2 class="text-2xl font-bold text-gray-800 mb-6">アカウント設定</h2>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>

      <div class="mb-4">
        <%= f.label :username, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :username, autofocus: true, autocomplete: "username",
            class: input_class(resource, :username) %>
        <%= inline_error(resource, :username) %>
      </div>

      <div class="mb-4">
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autocomplete: "email",
            class: input_class(resource, :email) %>
        <%= inline_error(resource, :email) %>
        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="text-xs text-yellow-600 mt-1">確認待ち: <%= resource.unconfirmed_email %></p>
        <% end %>
      </div>

      <div class="mb-4">
        <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <p class="text-xs text-gray-500 mb-1">変更しない場合は空欄のまま<% if @minimum_password_length %>（変更する場合は<%= @minimum_password_length %>文字以上）<% end %></p>
        <%= f.password_field :password, autocomplete: "new-password",
            class: input_class(resource, :password) %>
        <%= inline_error(resource, :password) %>
      </div>

      <div class="mb-4">
        <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: input_class(resource, :password_confirmation) %>
        <%= inline_error(resource, :password_confirmation) %>
      </div>

      <div class="mb-6">
        <%= f.label :current_password, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <p class="text-xs text-gray-500 mb-1">変更を確定するには現在のパスワードが必要です</p>
        <%= f.password_field :current_password, autocomplete: "current-password",
            class: input_class(resource, :current_password) %>
        <%= inline_error(resource, :current_password) %>
      </div>

      <%= f.submit "更新する", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2 rounded cursor-pointer" %>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-sm font-semibold text-red-600 mb-2">アカウントを削除する</h3>
    <%= button_to "アカウントを削除する", registration_path(resource_name),
        data: { turbo_confirm: "本当に削除しますか？この操作は取り消せません。" },
        method: :delete,
        class: "text-sm bg-red-50 hover:bg-red-100 text-red-600 border border-red-300 px-4 py-1.5 rounded cursor-pointer" %>
  </div>
</div>
