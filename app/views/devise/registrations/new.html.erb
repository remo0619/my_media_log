<div class="min-h-screen bg-gray-50 flex items-center justify-center py-12 px-4">
  <div class="max-w-md w-full bg-white rounded-lg shadow p-8">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">新規登録</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

      <div class="mb-4">
        <%= f.label :username, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :username, autofocus: true, autocomplete: "username",
            class: input_class(resource, :username) %>
        <%= inline_error(resource, :username) %>
      </div>

      <div class="mb-4">
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autocomplete: "email",
            class: input_class(resource, :email) %>
        <%= inline_error(resource, :email) %>
      </div>

      <div class="mb-4">
        <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-500 mb-1"><%= @minimum_password_length %>文字以上</p>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password",
            class: input_class(resource, :password) %>
        <%= inline_error(resource, :password) %>
      </div>

      <div class="mb-6">
        <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: input_class(resource, :password_confirmation) %>
        <%= inline_error(resource, :password_confirmation) %>
      </div>

      <%= f.submit "登録する", class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded cursor-pointer" %>
    <% end %>

    <div class="mt-4">
      <%= button_to "ゲストとしてログイン", guest_login_path,
          method: :post,
          class: "w-full bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-4 rounded cursor-pointer" %>
    </div>

    <div class="mt-4 text-center text-sm text-gray-500">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
