<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "MyMedia Log" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <nav class="bg-white border-b border-gray-200">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <%= link_to "MyMedia Log", root_path, class: "text-lg font-bold text-indigo-600 shrink-0" %>

        <%# デスクトップナビ %>
        <div class="hidden sm:flex items-center gap-4 text-sm">
          <% if user_signed_in? %>
            <%= link_to "一覧", contents_path, class: "text-gray-600 hover:text-indigo-600" %>
            <%= link_to "マイページ", mypage_path, class: "text-gray-600 hover:text-indigo-600" %>
            <span class="text-gray-400">|</span>
            <span class="text-gray-600"><%= current_user.username %></span>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete,
                class: "text-gray-500 hover:text-gray-700 cursor-pointer bg-transparent border-0 p-0" %>
          <% else %>
            <%= link_to "ログイン", new_user_session_path, class: "text-gray-600 hover:text-indigo-600" %>
            <%= link_to "新規登録", new_user_registration_path,
                class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-1.5 rounded" %>
          <% end %>
        </div>

        <%# モバイルハンバーガー %>
        <button id="nav-toggle" class="sm:hidden text-gray-500 hover:text-gray-700 p-1" aria-label="メニュー">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>

      <%# モバイルメニュー（初期非表示）%>
      <div id="nav-menu" class="hidden sm:hidden border-t border-gray-100 px-4 py-3 space-y-2 text-sm">
        <% if user_signed_in? %>
          <%= link_to "コンテンツ一覧", contents_path, class: "block text-gray-700 hover:text-indigo-600 py-1" %>
          <%= link_to "マイページ", mypage_path, class: "block text-gray-700 hover:text-indigo-600 py-1" %>
          <hr class="border-gray-100">
          <p class="text-gray-500 py-1"><%= current_user.username %></p>
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete,
              class: "block w-full text-left text-gray-500 hover:text-gray-700 cursor-pointer bg-transparent border-0 p-0 py-1" %>
        <% else %>
          <%= link_to "ログイン", new_user_session_path, class: "block text-gray-700 hover:text-indigo-600 py-1" %>
          <%= link_to "新規登録", new_user_registration_path, class: "block text-indigo-600 font-semibold py-1" %>
        <% end %>
      </div>
    </nav>

    <% if notice.present? %>
      <div class="max-w-5xl mx-auto mt-4 px-4">
        <p class="bg-green-50 border border-green-200 text-green-700 text-sm rounded px-4 py-2"><%= notice %></p>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="max-w-5xl mx-auto mt-4 px-4">
        <p class="bg-red-50 border border-red-200 text-red-700 text-sm rounded px-4 py-2"><%= alert %></p>
      </div>
    <% end %>

    <main class="max-w-5xl mx-auto px-4 py-8">
      <%= yield %>
    </main>

    <script>
      document.getElementById("nav-toggle").addEventListener("click", function() {
        document.getElementById("nav-menu").classList.toggle("hidden");
      });
    </script>
  </body>
</html>
