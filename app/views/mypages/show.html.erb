<div class="max-w-2xl mx-auto py-8 px-4">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">マイページ</h1>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="text-lg font-semibold text-gray-700 mb-4">アカウント情報</h2>
    <dl class="space-y-3">
      <div class="flex">
        <dt class="w-36 text-sm text-gray-500">ユーザー名</dt>
        <dd class="text-sm text-gray-800"><%= current_user.username %></dd>
      </div>
      <div class="flex">
        <dt class="w-36 text-sm text-gray-500">メールアドレス</dt>
        <dd class="text-sm text-gray-800"><%= current_user.email %></dd>
      </div>
    </dl>

    <% unless current_user.guest? %>
      <div class="mt-4">
        <%= link_to "プロフィールを編集する", edit_user_registration_path,
            class: "inline-block text-sm text-indigo-600 hover:text-indigo-800 font-medium" %>
      </div>
    <% else %>
      <p class="mt-4 text-sm text-gray-400">ゲストユーザーはプロフィールを編集できません</p>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-gray-700 mb-4">種別ごとのコンテンツ割合</h2>
    <% if @chart_data.any? %>
      <%= pie_chart @chart_data, donut: true, height: "300px", colors: ["#F59E0B", "#EF4444", "#8B5CF6", "#0EA5E9", "#9CA3AF"] %>
    <% else %>
      <p class="text-sm text-gray-400">コンテンツがまだ登録されていません</p>
    <% end %>
  </div>
</div>
